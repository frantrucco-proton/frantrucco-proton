# Only needed to preview the site locally -- GitHub Pages builds the site
# itself and ignores this file. Versions are pinned to what GitHub Pages runs
# so a local preview matches production.
#
#   bundle install
#   bundle exec jekyll serve   # then open http://127.0.0.1:4000/frantrucco-proton/
source "https://rubygems.org"

gem "jekyll", "~> 3.10"
gem "kramdown-parser-gfm", "~> 1.1"   # kramdown input: GFM (GitHub Pages default)
gem "webrick", "~> 1.8"               # jekyll serve needs this on Ruby 3+
